# ================================
# BINANCE API CREDENTIALS
# ================================
# Get from: https://testnet.binancefuture.com (TESTNET)
# or: https://www.binance.com/en/my/settings/api-management (LIVE)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# ================================
# BYBIT API (Optional)
# ================================
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ================================
# OKX API (Optional)
# ================================
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ================================
# TELEGRAM ALERTS
# ================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ================================
# 🧠 AI BRAIN (اختياري لكن موصى به)
# ================================
# AI Provider: gemini, openai, claude, ollama
AI_PROVIDER=gemini

# Google Gemini (مجاني - موصى به) ⭐
# احصل على مفتاح مجاني من: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (اختياري - مدفوع)
OPENAI_API_KEY=
USE_GPT4=false

# Claude (اختياري - مدفوع)
ANTHROPIC_API_KEY=

# Ollama (محلي مجاني)
OLLAMA_MODEL=llama3

# ================================
# DATABASE
# ================================
# PostgreSQL (للإنتاج) أو اتركه فارغ لـ SQLite
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# ================================
# CELERY (اختياري)
# ================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ================================
# BOT MODE
# ================================
BOT_MODE=testnet

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO

# ================================
# BINANCE API CREDENTIALS
# ================================
# Get from: https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Start with TESTNET credentials!
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# ================================
# TELEGRAM ALERTS
# ================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ================================
# DATABASE (OPTIONAL)
# ================================
DATABASE_URL=postgresql://user:password@localhost:5432/smc_ict_bot
REDIS_URL=redis://localhost:6379/0

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ================================
# BOT MODE
# ================================
# Options: live, testnet, paper, backtest
BOT_MODE=testnet

# ================================
# RISK PARAMETERS (Optional override)
# ================================
RISK_PER_TRADE_PCT=1.0
MAX_DRAWDOWN_PCT=10.0
MAX_DAILY_LOSS_PCT=3.0
